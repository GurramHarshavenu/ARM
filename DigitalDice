void delay_sec(unsigned int sec)
{
	T0PR=1500-1;
	T0TCR=1;
	while(T0TC<sec);
	T0TCR=3;
	T0TCR=0;
}
void delay_ms(unsigned int milliSec)
{
	T0PR=15000-1;
	T0TCR=1;
	while(T0TC<milliSec);
	T0TCR=3;
	T0TCR=0;
}
