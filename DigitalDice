#include "delay.h"
#define DATA 0XFF
#define RS 1<<8
#define E 1<<9
void LCD_INIT(void);
void LCD_CMD(unsigned char);
void LCD_DATA(unsigned char);
void LCD_STR(char*);
void LCD_INIT(void)
{ IODIR0|=DATA|RS|E;
	LCD_CMD(0X01);
	LCD_CMD(0X02);
	LCD_CMD(0X0C);
	LCD_CMD(0X38);
}
void LCD_CMD(unsigned char CMD)
{
	IOCLR0=DATA;
	IOSET0=CMD;
	IOCLR0=RS;
	IOSET0=E;
	delay_ms(200);
	IOCLR0=E;
}
void LCD_DATA(unsigned char D)
{
	IOCLR0=DATA;
	IOSET0=D|RS;
	IOSET0=E;
	delay_ms(200);
	IOCLR0=E;
}
void LCD_STR(char*p)
{
	while(*p)
	{
		LCD_DATA(*p++);
  }
}
